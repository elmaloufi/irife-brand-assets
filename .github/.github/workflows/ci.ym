name: IRIFE CI Pipeline

on:
  push:
    branches:
      - main

  pull_request:
    branches:
      - main

  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: irife-ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build-and-test:
    name: Build and Test
    runs-on: ubuntu-latest
    timeout-minutes: 20

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm
          cache-dependency-path: package-lock.json

      - name: Verify Node and npm
        run: |
          node --version
          npm --version

      - name: Install Dependencies
        run: npm ci

      - name: TypeScript and Build Validation
        run: npm run build

      - name: Run Tests
        run: npm test

      - name: Dependency Security Audit
        run: npm audit --omit=dev
        continue-on-error: true

      - name: CI Summary
        if: always()
        run: |
          echo "## IRIFE CI Results" >> "$GITHUB_STEP_SUMMARY"
          echo "- Commit: $GITHUB_SHA" >> "$GITHUB_STEP_SUMMARY"
          echo "- Branch: $GITHUB_REF_NAME" >> "$GITHUB_STEP_SUMMARY"
          echo "- Status: ${{ job.status }}" >> "$GITHUB_STEP_SUMMARY"

  deployment-gate:
    name: Production Deployment Gate
    needs: build-and-test
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest

    steps:
      - name: Deployment Status
        run: |
          echo "CI validation passed."
          echo "Production deployment is not configured."
          echo "Manual deployment approval is required."

