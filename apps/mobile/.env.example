# Public mobile API origin. Do not include /api/v1; the client adds versioned paths.
# Android emulator: 10.0.2.2 routes to the development computer's localhost.
# Physical Android device: replace the host with the computer's LAN IPv4 address.
# iOS simulator: http://127.0.0.1:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
