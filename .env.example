NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://irife:irife_local_dev_only@127.0.0.1:5432/irife?schema=public
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Transactional email (Resend). Configure a verified sender before enabling password recovery.
RESEND_API_KEY=
EMAIL_FROM=

# Stable 32-byte base64 key for encrypted refresh-rotation retry responses.
# Generate with: openssl rand -base64 32
# Required in production; keep unchanged across deployments during the retry window.
REFRESH_TOKEN_ENCRYPTION_KEY=
