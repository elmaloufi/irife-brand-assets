NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://irife:irife_local_dev_only@127.0.0.1:5432/irife?schema=public
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Transactional email (Resend). Configure a verified sender before enabling password recovery.
RESEND_API_KEY=
EMAIL_FROM=

# Optional public-apis catalogue adapters. Keep credentials server-side.
# Open-Meteo weather is available without an API key.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=IRIFE/0.1 (Morocco travel discovery)
TICKETMASTER_API_KEY=

# OpenAI-compatible ITRI provider. Leave unset to keep AI chat disabled.
# For production, ITRI_AI_BASE_URL must use HTTPS.
ITRI_AI_BASE_URL=https://api.openai.com/v1/chat/completions
ITRI_AI_API_KEY=
ITRI_AI_MODEL=
